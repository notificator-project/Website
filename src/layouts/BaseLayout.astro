---
import { AstroSeo, type AstroSeoProps } from "@astrolib/seo";
import BaseHead from "@components/BaseHead.astro";
import AccessibilityFontToggle from "@components/global/AccessibilityFontToggle.astro";
import Footer from "@components/global/Footer.astro";
import Navigation from "@components/global/Navigation.astro";
import { ClientRouter } from "astro:transitions";

type Props = {
	seo?: AstroSeoProps;
};

const { seo: seoProp } = Astro.props;

const shareImage = new URL("og.png", Astro.site).toString();

const defaultSeo: AstroSeoProps = {
	title: "Notificator | Website events turned into useful alerts",
	description: "Turn meaningful WordPress and Strapi events into local activity, mobile push notifications, email alerts, and MQTT messages.",
	canonical: "https://notificator-project.com/",
	openGraph: {
		url: "https://notificator-project.com/",
		title: "Notificator | Website alerts, your way",
		description: "Connect WordPress and Strapi events to local activity, your phone, email, or compatible MQTT devices.",
		images: [
			{
				url: shareImage,
				width: 1200,
				height: 630,
				alt: "Notificator",
				type: "image/png",
			},
		],
		site_name: "Notificator Project",
	},
	twitter: {
		handle: "@wp_notificator",
		site: "@wp_notificator",
		cardType: "summary_large_image",
	},
	additionalMetaTags: [
		{
			name: "publisher",
			content: "Vagelis P.",
		},
	],
};

const seo = {
	...defaultSeo,
	...seoProp,
	openGraph: {
		...defaultSeo.openGraph,
		...seoProp?.openGraph,
	},
	twitter: {
		...defaultSeo.twitter,
		...seoProp?.twitter,
	},
};
---

<!--
	Hello, curious human!

	Notificator turns meaningful website events into useful alerts.
	It is free, open source, and built in public.

	Explore the code: https://github.com/notificator-project
-->
<html lang="en">
	<head>
		<BaseHead />
		<AstroSeo {...seo} />
		<ClientRouter fallback="swap" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Navigation />
		<main id="main-content" tabindex="-1"><slot /></main>
		<Footer />
		<AccessibilityFontToggle />

		<script is:inline>
			console.info(
				"%c🔔 Hello from Notificator!",
				"color: #1f56db; font-size: 16px; font-weight: 700;",
				"\nYou found the developer corner. Explore the open-source project at https://github.com/notificator-project",
			);
		</script>
	</body>
</html>

---
import { Image } from "astro:assets";
import devicePhoto from "@assets/images/device/notificator-devices.jpeg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Notificator Devices",
	description: "Explore open-source Notificator device firmware, compatible ESP32 hardware, MQTT alerts, and community-built displays.",
	canonical: "https://notificator-project.com/devices/",
	openGraph: {
		url: "https://notificator-project.com/devices/",
		title: "Notificator Devices",
		description: "Build a dedicated physical display for the alerts that matter.",
	},
};

const buildSteps = [
	{
		number: "01",
		title: "Choose compatible hardware",
		copy: "Start with a supported ESP32 board, display, and the components described by the firmware project.",
	},
	{
		number: "02",
		title: "Install the firmware",
		copy: "Use the open-source firmware as provided or adapt it to the compatible hardware and display experience you want.",
	},
	{
		number: "03",
		title: "Connect through MQTT",
		copy: "Link the device to your Notificator account and route selected WordPress notifications to its MQTT channel.",
	},
	{
		number: "04",
		title: "Make it your own",
		copy: "Experiment with screens, enclosures, alert layouts, and physical outputs while respecting third-party asset licenses.",
	},
];
---

<BaseLayout seo={seo}>
	<section class="page-hero section-space">
		<div class="site-shell hero-layout">
			<div>
				<p class="eyebrow">Notificator devices</p>
				<h1 class="display-title">Give important alerts a place in the physical world.</h1>
				<p class="section-copy">
					Build a compact display for selected WordPress events using compatible ESP32 hardware, open-source Notificator firmware, and MQTT
					delivery.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#build-path">See how it connects</a>
					<a class="button button-secondary" href="https://github.com/notificator-project/IoT-Firmware-Early-Access">
						Explore the firmware ↗
					</a>
				</div>
			</div>

			<figure class="device-figure">
				<div>
					<Image src={devicePhoto} alt="A group of assembled Notificator display devices in different colours" loading="eager" />
					<span>Working prototypes</span>
				</div>
				<figcaption>Community-built Notificator devices using compact displays and custom enclosures.</figcaption>
			</figure>
		</div>
	</section>

	<section class="purpose-section section-space" aria-labelledby="purpose-title">
		<div class="site-shell purpose-layout">
			<div>
				<p class="eyebrow">A dedicated signal</p>
				<h2 id="purpose-title" class="section-title">Some alerts deserve more than another browser tab.</h2>
				<p class="section-copy">
					A Notificator device can keep a selected event visible without requiring the WordPress dashboard or your phone to remain open.
				</p>
			</div>
			<div class="purpose-grid">
				<article>
					<span aria-hidden="true">OLED</span><strong>Dedicated displays</strong><p>Show concise messages, state, and event details.</p>
				</article>
				<article>
					<span aria-hidden="true">MQTT</span><strong>Flexible delivery</strong><p>
						Use a lightweight channel designed for connected clients.
					</p>
				</article>
				<article>
					<span aria-hidden="true">ESP</span><strong>Maker friendly</strong><p>
						Build with accessible ESP32 hardware and adaptable firmware.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section id="build-path" class="build-section section-space" aria-labelledby="build-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Build path</p>
				<h2 id="build-title" class="section-title">From WordPress event to physical display.</h2>
				<p class="section-copy">The device is one optional destination in the wider Notificator workflow.</p>
			</div>

			<ol class="build-grid">
				{
					buildSteps.map((step) => (
						<li>
							<span>{step.number}</span>
							<h3>{step.title}</h3>
							<p>{step.copy}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="open-source-section section-space" aria-labelledby="open-source-title">
		<div class="site-shell open-source-card">
			<div>
				<p class="eyebrow">Open-source foundation</p>
				<h2 id="open-source-title">Inspect it, build it, and adapt it.</h2>
				<p>
					The Notificator device firmware is published openly so makers and developers can understand how it works, build compatible
					hardware, and contribute improvements.
				</p>
			</div>
			<ul>
				<li>Open-source firmware</li>
				<li>Compatible ESP32 hardware</li>
				<li>MQTT-based notification delivery</li>
				<li>Room for custom displays and outputs</li>
			</ul>
			<div class="source-actions">
				<a class="button button-primary" href="https://github.com/notificator-project/IoT-Firmware-Early-Access">View the firmware ↗</a>
				<a href="/how-it-works/">See the full notification workflow →</a>
			</div>
		</div>
	</section>

	<section class="community-section section-space" aria-labelledby="community-title">
		<div class="site-shell community-layout">
			<div>
				<p class="eyebrow">Built with the community</p>
				<h2 id="community-title" class="section-title">From a public experiment to devices shared with real people.</h2>
				<p class="section-copy">
					Notificator devices were first introduced publicly at WordCamp Athens 2025. Dozens of early units have since been shared, and
					occasional community batches continue to be given away at no cost.
				</p>
			</div>
			<aside>
				<strong>Build one yourself</strong>
				<p>Follow the firmware repository for supported hardware, setup guidance, and project updates.</p>
				<strong>Watch for giveaways</strong>
				<p>Project news and community channels announce future device batches and testing opportunities.</p>
			</aside>
		</div>
	</section>

	<section class="license-section">
		<div class="site-shell license-card">
			<div>
				<p class="eyebrow">Enclosure attribution</p>
				<h2>Open firmware and separately licensed enclosure files.</h2>
				<p>
					The enclosure shown by Notificator is based on the TinyTosh Mini Retro PC by Uladzimir Hitsarau. The model is licensed separately
					under the MakerWorld Standard Digital File License and is not redistributed by this project.
				</p>
			</div>
			<div class="license-actions">
				<a class="button button-primary" href="https://makerworld.com/en/models/2270326-tinytosh-mini-retro-pc-smart-wifi-display-esp32">
					View the original model ↗
				</a>
				<a href="https://makerworld.com/en/@hitsarau">Meet the designer ↗</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding-top: clamp(70px, 8vw, 110px);
	}

	.hero-layout,
	.purpose-layout,
	.community-layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(50px, 8vw, 110px);
		align-items: center;
	}

	.page-hero .display-title {
		max-width: 850px;
	}

	.hero-actions,
	.source-actions,
	.license-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.device-figure {
		margin: 0;
	}

	.device-figure > div {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 10px solid #0b1020;
		border-radius: 30px;
		background: #0b1020;
		box-shadow: 0 35px 90px rgba(29, 49, 99, 0.22);
		transform: rotate(-1deg);
	}

	.device-figure :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 20px;
		object-fit: cover;
	}

	.device-figure span {
		position: absolute;
		bottom: 18px;
		left: 18px;
		border-radius: 999px;
		background: rgba(11, 16, 32, 0.78);
		padding: 7px 11px;
		font-size: 0.75rem;
		font-weight: 700;
		color: white;
	}

	.device-figure figcaption {
		margin-top: 18px;
		font-size: 0.8rem;
		line-height: 1.6;
		color: #667088;
	}

	.purpose-section {
		background: linear-gradient(145deg, #edf3ff, #f8faff 64%);
	}

	.purpose-layout {
		align-items: end;
	}

	.purpose-grid {
		display: grid;
		gap: 12px;
	}

	.purpose-grid article {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 5px 14px;
		border: 1px solid rgba(112, 142, 210, 0.22);
		border-radius: 17px;
		background: rgba(255, 255, 255, 0.74);
		padding: 18px;
	}

	.purpose-grid article > span {
		grid-row: 1 / 3;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 800;
		color: var(--blue);
	}

	.purpose-grid p {
		margin: 0;
		color: var(--ink-soft);
	}

	.build-section {
		background: white;
	}

	.section-heading {
		max-width: 800px;
	}

	.build-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin: 52px 0 0;
		padding: 0;
		list-style: none;
	}

	.build-grid li {
		border: 1px solid var(--line);
		border-radius: 21px;
		background: #f9faff;
		padding: 25px;
	}

	.build-grid li > span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--blue);
	}

	.build-grid h3 {
		margin: 50px 0 0;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
	}

	.build-grid p {
		color: var(--ink-soft);
	}

	.open-source-card,
	.license-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
		gap: 30px 70px;
		border-radius: 28px;
		background: #0b1020;
		padding: clamp(30px, 6vw, 64px);
		color: white;
	}

	.open-source-card h2,
	.license-card h2 {
		max-width: 720px;
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.5rem);
		letter-spacing: -0.05em;
		line-height: 1.05;
	}

	.open-source-card p:not(.eyebrow),
	.license-card p:not(.eyebrow) {
		max-width: 680px;
		color: #c7d1e8;
	}

	.open-source-card ul {
		display: grid;
		gap: 12px;
		align-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.open-source-card li {
		position: relative;
		padding-left: 25px;
		color: #dce4fa;
	}

	.open-source-card li::before {
		position: absolute;
		left: 0;
		color: #65dda5;
		content: "✓";
	}

	.source-actions {
		grid-column: 1 / -1;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 28px;
	}

	.source-actions > a:not(.button),
	.license-actions > a:not(.button) {
		color: #dce4fa;
	}

	.community-layout {
		align-items: start;
	}

	.community-layout aside {
		border-left: 3px solid #a9bfff;
		padding-left: clamp(22px, 4vw, 40px);
	}

	.community-layout aside strong:not(:first-child) {
		display: block;
		margin-top: 28px;
	}

	.community-layout aside p {
		color: var(--ink-soft);
	}

	.license-section {
		padding: 30px 0 36px;
	}

	.license-card {
		align-items: end;
		background: #121a2f;
	}

	.license-actions {
		align-items: flex-start;
		flex-direction: column;
		margin: 0;
	}

	@media (max-width: 820px) {
		.hero-layout,
		.purpose-layout,
		.community-layout,
		.open-source-card,
		.license-card {
			grid-template-columns: 1fr;
		}

		.build-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.build-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

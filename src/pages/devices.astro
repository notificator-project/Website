---
import { Image } from "astro:assets";
import deviceRender from "@assets/images/device/notificator-base-alert-render.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Notificator Devices",
	description: "Explore open-source Notificator device firmware, compatible ESP32 hardware, MQTT alerts, and community-built displays.",
	canonical: "https://notificator-project.com/devices/",
	openGraph: {
		url: "https://notificator-project.com/devices/",
		title: "Notificator Devices",
		description: "Build a dedicated physical display for the alerts that matter.",
	},
};

const buildSteps = [
	{
		number: "01",
		title: "Choose compatible hardware",
		copy: "Start with a supported ESP32 board, display, and the components described by the firmware project.",
	},
	{
		number: "02",
		title: "Install the firmware",
		copy: "Choose a compatible release and flash the complete firmware over USB with the browser installer.",
	},
	{
		number: "03",
		title: "Connect through MQTT",
		copy: "Link the device to your Notificator account and route selected WordPress notifications to its MQTT channel.",
	},
	{
		number: "04",
		title: "Make it your own",
		copy: "Experiment with screens, enclosures, alert layouts, and physical outputs while respecting third-party asset licenses.",
	},
];
---

<BaseLayout seo={seo}>
	<section class="page-hero section-space">
		<div class="site-shell hero-layout">
			<div>
				<p class="eyebrow">Notificator devices</p>
				<h1 class="display-title">Give important alerts a place in the physical world.</h1>
				<p class="section-copy">
					Build a compact display for selected WordPress events using compatible ESP32 hardware, open-source Notificator firmware, and MQTT
					delivery.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/get-a-device/">Get a device</a>
					<a class="button button-secondary" href="/build-a-device/">Build a device</a>
					<a href="/firmware-installer/">Install firmware →</a>
					<a href="https://github.com/notificator-project/IoT-Firmware">Explore the firmware ↗</a>
				</div>
				<aside class="hero-batch-note">
					<span aria-hidden="true">●</span>
					<p>
						<strong>You do not have to build one yourself.</strong> Follow the project for future limited batches of ready-to-use devices sent
						free of charge to randomly selected community members.
						<a href="#community-batches">Learn about community batches ↓</a>
					</p>
				</aside>
			</div>

			<figure class="device-figure">
				<div>
					<Image src={deviceRender} alt="Rendered Notificator Base showing a new-order alert on its OLED display" loading="eager" />
					<span>Notificator Base</span>
				</div>
				<figcaption>A compact open-source alert display built around accessible ESP32 hardware.</figcaption>
			</figure>
		</div>
	</section>

	<section class="purpose-section section-space" aria-labelledby="purpose-title">
		<div class="site-shell purpose-layout">
			<div>
				<p class="eyebrow">A dedicated signal</p>
				<h2 id="purpose-title" class="section-title">Some alerts deserve more than another browser tab.</h2>
				<p class="section-copy">
					A Notificator device can keep a selected event visible without requiring the WordPress dashboard or your phone to remain open.
				</p>
			</div>
			<div class="purpose-grid">
				<article>
					<span aria-hidden="true">OLED</span><strong>Dedicated displays</strong><p>Show concise messages, state, and event details.</p>
				</article>
				<article>
					<span aria-hidden="true">MQTT</span><strong>Flexible delivery</strong><p>
						Use a lightweight channel designed for connected clients.
					</p>
				</article>
				<article>
					<span aria-hidden="true">ESP</span><strong>Maker friendly</strong><p>
						Build with accessible ESP32 hardware and adaptable firmware.
					</p>
				</article>
			</div>
		</div>
	</section>

	<section class="models-section section-space" aria-labelledby="models-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Choose a model</p>
				<h2 id="models-title" class="section-title">A compact Base and a touchscreen preview.</h2>
				<p class="section-copy">
					Each model has its own hardware target and release channel, while sharing the same Notificator account, MQTT topics, and signed
					update system.
				</p>
			</div>
			<div class="model-grid">
				<article class="model-card">
					<div class="model-meta"><span>Base</span><small>Stable</small></div>
					<h3>Notificator Base</h3>
					<p>Stable firmware 1.2.2 for an ESP32-C3 SuperMini, SSD1306 OLED, and TTP223 capacitive control.</p>
					<div class="model-actions">
						<a href="/build-a-device/">Explore the Base build →</a>
						<a href="https://docs.notificator-project.com/guides/notificator-base-setup/">Setup guide ↗</a>
					</div>
				</article>
				<article class="model-card model-card--touch">
					<div class="model-meta"><span>Touch 3.49</span><small>Preview</small></div>
					<h3>Notificator Touch</h3>
					<p>Preview firmware 0.9.3 for the Waveshare ESP32-S3 Touch LCD 3.49, with audio, clock, weather, and alert history.</p>
					<div class="model-actions">
						<a href="/get-a-device/#compatible-hardware">See compatible hardware →</a>
						<a href="https://docs.notificator-project.com/guides/notificator-touch-setup/">Setup guide ↗</a>
					</div>
				</article>
				<article class="model-card model-card--future">
					<div>
						<div class="model-meta"><span>What comes next</span><small>In development</small></div><h3>
							More tested hardware over time.
						</h3>
					</div>
					<p>
						Matter and other models remain future targets. Each supported board receives its own firmware identity and update channel, so
						packages cannot cross between incompatible devices.
					</p>
					<a href="/changelog/#release-timeline">Follow firmware updates →</a>
				</article>
			</div>
		</div>
	</section>

	<section id="build-path" class="build-section section-space" aria-labelledby="build-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Build path</p>
				<h2 id="build-title" class="section-title">From WordPress event to physical display.</h2>
				<p class="section-copy">The device is one optional destination in the wider Notificator workflow.</p>
			</div>

			<ol class="build-grid">
				{
					buildSteps.map((step) => (
						<li>
							<span>{step.number}</span>
							<h3>{step.title}</h3>
							<p>{step.copy}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="open-source-section section-space" aria-labelledby="open-source-title">
		<div class="site-shell open-source-card">
			<div>
				<p class="eyebrow">Open-source foundation</p>
				<h2 id="open-source-title">Inspect it, build it, and adapt it.</h2>
				<p>
					The Notificator device firmware is published openly so makers and developers can understand how it works, build compatible
					hardware, and contribute improvements.
				</p>
			</div>
			<ul>
				<li>Open-source firmware</li>
				<li>Compatible ESP32 hardware</li>
				<li>MQTT-based notification delivery</li>
				<li>Room for custom displays and outputs</li>
			</ul>
			<div class="source-actions">
				<a class="button button-primary" href="/get-a-device/">Compare device options</a>
				<a class="button button-secondary" href="/firmware-installer/">Open the web installer</a>
				<a class="button button-secondary" href="/build-a-device/">Explore the hardware build</a>
				<a href="https://github.com/notificator-project/IoT-Firmware">View the firmware ↗</a>
				<a href="/how-it-works/">See the full notification workflow →</a>
			</div>
		</div>
	</section>

	<section id="community-batches" class="community-section section-space" aria-labelledby="community-title">
		<div class="site-shell">
			<div class="community-heading">
				<div>
					<p class="eyebrow">Community batches</p>
					<h2 id="community-title" class="section-title">Cannot build one? You may still get one.</h2>
				</div>
				<p class="section-copy">
					Notificator devices were introduced publicly at WordCamp Athens 2025, where the first devices were shared with attendees. We plan
					to keep making occasional small batches and send ready-to-use devices free of charge to randomly selected people in the community.
				</p>
			</div>

			<div class="batch-grid">
				<article>
					<span aria-hidden="true">01</span>
					<strong>Ready to use</strong>
					<p>Each device is printed, assembled, flashed, and tested before it leaves us.</p>
				</article>
				<article>
					<span aria-hidden="true">02</span>
					<strong>Free community project</strong>
					<p>The devices are not sold. Selected recipients receive their device at no charge.</p>
				</article>
				<article>
					<span aria-hidden="true">03</span>
					<strong>Small and random batches</strong>
					<p>Quantities are limited, and recipients are selected randomly according to the details announced for each batch.</p>
				</article>
			</div>

			<div class="batch-follow">
				<div>
					<strong>How will I know when a batch is available?</strong>
					<p>
						Follow project updates. Every opportunity will explain its timing, availability, selection process, and any location
						restrictions before entries open.
					</p>
				</div>
				<div class="batch-actions">
					<a class="button button-primary" href="/blog/">Follow the Journal</a>
					<a href="https://x.com/WP_Notificator" target="_blank" rel="noreferrer">Follow on X ↗</a>
					<a href="https://www.youtube.com/@NotificatorProject" target="_blank" rel="noreferrer">Follow on YouTube ↗</a>
				</div>
			</div>
		</div>
	</section>

	<section class="license-section">
		<div class="site-shell license-card">
			<div>
				<p class="eyebrow">Enclosure attribution</p>
				<h2>Open firmware and separately licensed enclosure files.</h2>
				<p>
					The enclosure shown by Notificator is based on the TinyTosh Mini Retro PC by Uladzimir Hitsarau. The model is licensed separately
					under the MakerWorld Standard Digital File License and is not redistributed by this project.
				</p>
			</div>
			<div class="license-actions">
				<a class="button button-primary" href="https://makerworld.com/en/models/2270326-tinytosh-mini-retro-pc-smart-wifi-display-esp32">
					View the original model ↗
				</a>
				<a href="https://makerworld.com/en/@hitsarau">Meet the designer ↗</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding-top: clamp(70px, 8vw, 110px);
	}

	.hero-layout,
	.purpose-layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(50px, 8vw, 110px);
		align-items: center;
	}

	.page-hero .display-title {
		max-width: 850px;
	}

	.hero-actions,
	.source-actions,
	.license-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.hero-batch-note {
		display: flex;
		max-width: 650px;
		align-items: flex-start;
		gap: 12px;
		margin-top: 24px;
		border-radius: 16px;
		background: rgba(234, 240, 255, 0.82);
		padding: 16px 18px;
		color: var(--ink-soft);
	}

	.hero-batch-note > span {
		margin-top: 4px;
		font-size: 0.7rem;
		color: var(--success);
	}

	.hero-batch-note p {
		margin: 0;
	}

	.hero-batch-note strong {
		color: var(--ink);
	}

	.hero-batch-note a {
		font-weight: 700;
		color: var(--blue);
	}

	.device-figure {
		margin: 0;
	}

	.device-figure > div {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 10px solid #0b1020;
		border-radius: 30px;
		background: #0b1020;
		box-shadow: 0 35px 90px rgba(29, 49, 99, 0.22);
		transform: rotate(-1deg);
	}

	.device-figure :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 20px;
		object-fit: cover;
	}

	.device-figure span {
		position: absolute;
		bottom: 18px;
		left: 18px;
		border-radius: 999px;
		background: rgba(11, 16, 32, 0.78);
		padding: 7px 11px;
		font-size: 0.75rem;
		font-weight: 700;
		color: white;
	}

	.device-figure figcaption {
		margin-top: 18px;
		font-size: 0.8rem;
		line-height: 1.6;
		color: #667088;
	}

	.purpose-section {
		background: linear-gradient(145deg, #edf3ff, #f8faff 64%);
	}

	.purpose-layout {
		align-items: end;
	}

	.purpose-grid {
		display: grid;
		gap: 12px;
	}

	.purpose-grid article {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 5px 14px;
		border: 1px solid rgba(112, 142, 210, 0.22);
		border-radius: 17px;
		background: rgba(255, 255, 255, 0.74);
		padding: 18px;
	}

	.purpose-grid article > span {
		grid-row: 1 / 3;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 800;
		color: var(--blue);
	}

	.purpose-grid p {
		margin: 0;
		color: var(--ink-soft);
	}

	.model-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: 48px;
	}

	.model-card {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		min-height: 270px;
		border: 1px solid #d8e2f7;
		border-radius: 24px;
		background: white;
		padding: clamp(25px, 4vw, 38px);
		box-shadow: 0 18px 50px rgba(35, 63, 128, 0.07);
	}

	.model-card--touch {
		border-color: #bcd0ff;
		background: linear-gradient(145deg, #fff, #f1f5ff);
	}

	.model-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
	}

	.model-meta span,
	.model-meta small {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.model-meta span {
		color: var(--blue);
	}

	.model-meta small {
		border-radius: 999px;
		background: #e9f7f0;
		padding: 6px 9px;
		color: #13754b;
	}

	.model-card--touch .model-meta small {
		background: #e9efff;
		color: var(--blue);
	}

	.model-card h3 {
		margin: 44px 0 0;
		font-size: clamp(1.45rem, 2.5vw, 2rem);
		letter-spacing: -0.04em;
	}

	.model-card > p {
		margin: 12px 0 0;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.model-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		margin-top: auto;
		padding-top: 32px;
	}

	.model-actions a,
	.model-card--future > a {
		font-weight: 750;
		color: var(--blue);
	}

	.model-card--future {
		display: grid;
		grid-template-columns: minmax(260px, 0.7fr) minmax(300px, 1fr) auto;
		grid-column: 1 / -1;
		min-height: 0;
		gap: 28px;
		align-items: center;
		border-style: dashed;
		background: rgba(255, 255, 255, 0.56);
		box-shadow: none;
	}

	.model-card--future .model-meta {
		justify-content: flex-start;
	}

	.model-card--future .model-meta small {
		background: #eef1f7;
		color: #59647b;
	}

	.model-card--future h3,
	.model-card--future p {
		margin: 12px 0 0;
	}

	.build-section {
		background: white;
	}

	.section-heading {
		max-width: 800px;
	}

	.build-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin: 52px 0 0;
		padding: 0;
		list-style: none;
	}

	.build-grid li {
		border: 1px solid var(--line);
		border-radius: 21px;
		background: #f9faff;
		padding: 25px;
	}

	.build-grid li > span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
		font-weight: 800;
		color: var(--blue);
	}

	.build-grid h3 {
		margin: 50px 0 0;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
	}

	.build-grid p {
		color: var(--ink-soft);
	}

	.open-source-card,
	.license-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
		gap: 30px 70px;
		border-radius: 28px;
		background: #0b1020;
		padding: clamp(30px, 6vw, 64px);
		color: white;
	}

	.open-source-card h2,
	.license-card h2 {
		max-width: 720px;
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.5rem);
		letter-spacing: -0.05em;
		line-height: 1.05;
	}

	.open-source-card p:not(.eyebrow),
	.license-card p:not(.eyebrow) {
		max-width: 680px;
		color: #c7d1e8;
	}

	.open-source-card ul {
		display: grid;
		gap: 12px;
		align-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.open-source-card li {
		position: relative;
		padding-left: 25px;
		color: #dce4fa;
	}

	.open-source-card li::before {
		position: absolute;
		left: 0;
		color: #65dda5;
		content: "✓";
	}

	.source-actions {
		grid-column: 1 / -1;
		align-items: center;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 28px;
	}

	.source-actions > a:not(.button),
	.license-actions > a:not(.button) {
		color: #dce4fa;
	}

	.community-heading {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(40px, 8vw, 100px);
		align-items: start;
	}

	.community-heading .section-copy {
		margin-top: 0;
	}

	.batch-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-top: 50px;
	}

	.batch-grid article {
		display: grid;
		align-content: start;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: white;
		padding: 25px;
	}

	.batch-grid span {
		margin-bottom: 46px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.76rem;
		font-weight: 800;
		color: var(--blue);
	}

	.batch-grid strong {
		font-size: 1.15rem;
	}

	.batch-grid p,
	.batch-follow p {
		color: var(--ink-soft);
	}

	.batch-follow {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 30px;
		align-items: center;
		margin-top: 14px;
		border-radius: 20px;
		background: #eaf0ff;
		padding: clamp(24px, 4vw, 38px);
	}

	.batch-follow p {
		max-width: 650px;
		margin-bottom: 0;
	}

	.batch-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 12px 18px;
	}

	.batch-actions > a:not(.button) {
		font-weight: 700;
		color: var(--blue);
	}

	.license-section {
		padding: 30px 0 36px;
	}

	.license-card {
		align-items: end;
		background: #121a2f;
	}

	.license-actions {
		align-items: flex-start;
		flex-direction: column;
		margin: 0;
	}

	@media (max-width: 820px) {
		.hero-layout,
		.purpose-layout,
		.community-heading,
		.batch-follow,
		.open-source-card,
		.license-card {
			grid-template-columns: 1fr;
		}

		.batch-grid {
			grid-template-columns: 1fr;
		}

		.model-card--future {
			grid-template-columns: 1fr;
		}

		.batch-actions {
			justify-content: flex-start;
		}

		.build-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.model-grid {
			grid-template-columns: 1fr;
		}

		.model-card--future {
			grid-column: auto;
		}

		.build-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const dashboardUrl = "https://dashboard.notificator-project.com";
const seo: AstroSeoProps = {
	title: "Notificator Web Dashboard | Your account, in your browser",
	description:
		"Create a Notificator account, manage API keys, read notifications, and monitor connected devices in the web dashboard beta. No mobile app required.",
	canonical: "https://notificator-project.com/dashboard/",
};
const features = [
	{
		number: "01",
		title: "An account without an app install",
		copy: "Register in your browser or sign in with your existing Notificator account. The dashboard and mobile app share your account and connected data.",
	},
	{
		number: "02",
		title: "Keys for every integration",
		copy: "Create WordPress, Strapi, or Public API keys for Astro and Node.js. Inspect last-used information, edit names and domains, copy active keys, or revoke access.",
	},
	{
		number: "03",
		title: "Your notifications, with context",
		copy: "Search and filter connected alerts, read useful fields and raw data, manage read status, and lock important notifications. In-dashboard toasts help you notice new arrivals.",
	},
	{
		number: "04",
		title: "Connected devices at a glance",
		copy: "Add devices, monitor reported connection status, pause or resume delivery, and manage supported settings. Configure HiveMQ to refresh device status and request signed Base or Touch OTA updates.",
	},
];
---

<BaseLayout seo={seo}>
	<section class="section-space dashboard-section" aria-labelledby="dashboard-title">
		<div class="site-shell dashboard-hero">
			<div>
				<p class="eyebrow">Web dashboard · Beta 0.1.0</p>
				<h1 id="dashboard-title" class="display-title">Your Notificator account. Right in your browser.</h1>
				<p class="section-copy">
					Create an account, connect your integrations, review notifications, and keep an eye on your devices. Start on the web, use the
					mobile app, or use both.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href={dashboardUrl}>Open the dashboard ↗</a>
					<a class="button button-secondary" href={`${dashboardUrl}/register`}>Create an account</a>
				</div>
				<p class="dashboard-note">Already using the mobile app? Sign in with the same credentials.</p>
			</div>
			<aside class="dashboard-summary" aria-labelledby="browser-start-title">
				<p class="eyebrow">No phone required to get started</p>
				<h2 id="browser-start-title">One account. Your choice of screen.</h2>
				<ul>
					<li>Create your account and integration API keys</li>
					<li>Read and organise connected notifications</li>
					<li>Monitor and manage supported devices</li>
					<li>Keep the mobile app for push alerts on the go</li>
				</ul>
				<a href="https://docs.notificator-project.com/guides/web-dashboard/">Read the dashboard guide →</a>
			</aside>
		</div>
	</section>

	<section class="section-space dashboard-section dashboard-features" aria-labelledby="dashboard-features-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Everyday account tasks</p><h2 id="dashboard-features-title" class="section-title">
					Less switching. More useful context.
				</h2>
			</div>
			<div class="dashboard-feature-grid">
				{
					features.map((feature) => (
						<article>
							<span class="eyebrow">{feature.number}</span>
							<h3>{feature.title}</h3>
							<p>{feature.copy}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-space dashboard-section" aria-labelledby="dashboard-choice-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Choose what you need</p><h2 id="dashboard-choice-title" class="section-title">The web and app work together.</h2>
			</div>
			<div class="dashboard-feature-grid">
				<article>
					<h3>Use the app for mobile push</h3><p>
						The dashboard is a browser-based account tool. Mobile push still needs the Notificator app, the same account, and notification
						permission. In-dashboard toasts appear while the dashboard is open; they are not background browser push.
					</p><a href="/mobile-app/">Explore the mobile app →</a>
				</article>
				<article>
					<h3>Local activity can stay local</h3><p>
						WordPress dashboard alerts and Strapi panel activity stay inside their own admin areas without an account. The Notificator web
						dashboard is a separate, shared inbox for events sent through connected integrations.
					</p><a href="/get-started/">Choose your integration →</a>
				</article>
			</div>
			<p class="dashboard-note dashboard-beta-note">
				Beta: features may change. Device status and commands depend on a working HiveMQ connection. Live brightness and Touch volume controls
				remain available in the mobile app.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.dashboard-section {
		padding-block: clamp(48px, 6vw, 68px);
	}
	.section-heading {
		padding-bottom: clamp(28px, 3vw, 40px);
	}
	.section-heading .eyebrow {
		margin-bottom: 14px;
	}
	.section-heading .section-title {
		max-width: 900px;
		font-size: clamp(1.875rem, 3vw, 2.75rem);
		line-height: 1.15;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.dashboard-hero .display-title {
		font-size: clamp(2.5rem, 4.6vw, 4rem);
		line-height: 1.06;
		text-wrap: balance;
	}
	.dashboard-hero .section-copy {
		margin-top: 24px;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 28px;
	}
	.dashboard-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
		gap: clamp(32px, 4vw, 56px);
		align-items: center;
	}
	.dashboard-summary {
		padding: clamp(24px, 3vw, 38px);
		background: var(--ink);
		color: white;
		border-radius: var(--radius-lg);
	}
	.dashboard-summary .eyebrow {
		color: #a9c6ff;
		margin-bottom: 20px;
	}
	.eyebrow::before {
		flex-shrink: 0;
	}
	.dashboard-summary h2 {
		margin: 0 0 24px;
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		line-height: 1.2;
	}
	.dashboard-summary ul {
		padding-left: 22px;
		margin: 0 0 28px;
		color: #d8e2f6;
	}
	.dashboard-summary li + li {
		margin-top: 14px;
	}
	.dashboard-summary a {
		color: #a9c6ff;
		font-weight: 700;
	}
	.dashboard-features {
		background: var(--blue-pale);
	}
	.dashboard-feature-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}
	.dashboard-feature-grid article {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(24px, 3vw, 32px);
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--surface);
	}
	.dashboard-feature-grid h3 {
		margin: 0 0 14px;
		font-size: 1.35rem;
		line-height: 1.35;
	}
	.dashboard-feature-grid p {
		margin: 0;
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.dashboard-feature-grid a {
		display: inline-block;
		margin-top: auto;
		padding-top: 24px;
		color: var(--blue);
		font-weight: 700;
	}
	.dashboard-note {
		margin: 20px 0 0;
		color: var(--ink-soft);
		line-height: 1.7;
	}
	.dashboard-beta-note {
		margin-top: 32px;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	@media (max-width: 820px) {
		.dashboard-hero,
		.dashboard-feature-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 480px) {
		.hero-actions {
			flex-direction: column;
			align-items: stretch;
		}
		.dashboard-feature-grid {
			gap: 16px;
		}
	}
</style>

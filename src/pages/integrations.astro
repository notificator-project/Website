---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Notificator Integrations | WordPress and Strapi",
	description:
		"Choose WordPress or Strapi as a Notificator event source, then keep activity local or deliver it to mobile, email, and MQTT devices.",
	canonical: "https://notificator-project.com/integrations/",
	openGraph: {
		url: "https://notificator-project.com/integrations/",
		title: "Notificator Integrations",
		description: "Two event sources, one understandable path from website activity to a useful alert.",
	},
};

const destinations = [
	{ marker: "LOCAL", title: "Local activity", copy: "Keep useful events in the WordPress dashboard or Strapi admin panel." },
	{ marker: "APP", title: "Mobile push", copy: "Receive selected alerts through the Notificator app for iOS and Android." },
	{ marker: "@", title: "Email alerts", copy: "Use the account email preference as an optional additional destination." },
	{ marker: "IoT", title: "MQTT devices", copy: "Route alerts through your own HiveMQ Cloud connection to compatible devices." },
];
---

<BaseLayout seo={seo}>
	<section class="page-hero section-space">
		<div class="site-shell hero-grid">
			<div>
				<p class="eyebrow">Integrations</p>
				<h1 class="display-title">Choose where your events begin.</h1>
				<p class="section-copy">
					Connect WordPress or Strapi, decide which activity matters, and send each resulting alert only to the places where it is useful.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#platforms">Compare integrations</a><a
						class="button button-secondary"
						href="/how-it-works/">
						See the shared workflow
					</a>
				</div>
			</div>
			<aside class="source-map" aria-label="WordPress and Strapi events flowing into Notificator">
				<div class="source-row"><span>WP</span><div><small>Stable</small><strong>WordPress event</strong></div></div>
				<div class="source-row"><span>S</span><div><small>Preview</small><strong>Strapi content event</strong></div></div>
				<i aria-hidden="true">↓</i>
				<div class="notificator-node"><span>N</span><div><small>Shared layer</small><strong>Notificator alert</strong></div></div>
			</aside>
		</div>
	</section>

	<section id="platforms" class="platform-section section-space" aria-labelledby="platform-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Available integrations</p><h2 id="platform-title" class="section-title">
					Different platforms, clearly defined capabilities.
				</h2><p class="section-copy">
					The integrations share connected destinations, but their discovery, rule-building, and local activity experiences remain native to
					each platform.
				</p>
			</div>
			<div class="platform-grid">
				<a href="/wordpress/">
					<div class="platform-top"><span>WP</span><small>Stable · Public</small></div>
					<h3>WordPress Plugin</h3>
					<p>Turn WordPress core, plugin, commerce, form, and custom hook events into notifications through a guided workflow.</p>
					<ul>
						<li>Hook discovery and plain-language descriptions</li><li>Built-in and third-party templates</li><li>
							Conditions, throttling, and reusable exports
						</li><li>Local dashboard alerts without an account</li>
					</ul>
					<strong>Explore WordPress →</strong>
				</a>
				<a class="preview" href="/strapi/">
					<div class="platform-top"><span>S</span><small>0.1.1 Preview</small></div>
					<h3>Strapi Extension</h3>
					<p>Turn Strapi 5 content lifecycle activity into named rules without maintaining separate handlers for every content type.</p>
					<ul>
						<li>Create, update, publish, unpublish, and delete actions</li><li>
							Safe entry, model, event, and actor template values
						</li><li>Local activity history and admin toasts</li><li>Server-side secrets and optional connected delivery</li>
					</ul>
					<strong>Explore Strapi →</strong>
				</a>
			</div>
		</div>
	</section>

	<section class="shared-section section-space" aria-labelledby="shared-title">
		<div class="site-shell shared-layout">
			<div>
				<p class="eyebrow">Shared alert layer</p><h2 id="shared-title" class="section-title">One understandable path after the event.</h2><p
					class="section-copy">
					Each integration identifies the event and builds a readable message. Notificator then applies the selected connected destinations
					without erasing the platform-specific local experience.
				</p><a href="/how-it-works/">Follow the complete workflow →</a>
			</div>
			<ol class="shared-steps">
				<li><span>01</span><div><strong>An event occurs</strong><p>A WordPress hook fires or a Strapi entry changes.</p></div></li><li>
					<span>02</span><div>
						<strong>A rule adds meaning</strong><p>Templates and available values create a useful title, message, and severity.</p>
					</div>
				</li><li>
					<span>03</span><div>
						<strong>You choose the reach</strong><p>Keep it local, or connect the inbox, phone, email, and devices.</p>
					</div>
				</li>
			</ol>
		</div>
	</section>

	<section class="destination-section section-space" aria-labelledby="destination-title">
		<div class="site-shell">
			<div class="section-heading">
				<p class="eyebrow">Destinations</p><h2 id="destination-title" class="section-title">
					The event source changes. The useful destinations stay familiar.
				</h2>
			</div><div class="destination-grid">
				{
					destinations.map((destination) => (
						<article>
							<>
								<span>{destination.marker}</span>
								<h3>{destination.title}</h3>
								<p>{destination.copy}</p>
							</>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="future-section">
		<div class="site-shell future-card">
			<div>
				<p class="eyebrow">More sources over time</p><h2>Notificator is no longer tied to one CMS.</h2><p>
					WordPress remains the mature integration and Strapi begins the next phase. Future sources will join only when they can offer a
					clear, maintainable event and rule experience.
				</p>
			</div><div>
				<a class="button button-primary" href="https://github.com/notificator-project">Follow development ↗</a><a href="/contact/">
					Discuss an integration →
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding-top: clamp(70px, 8vw, 110px);
	}
	.hero-grid,
	.shared-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(330px, 0.85fr);
		gap: clamp(46px, 8vw, 105px);
		align-items: center;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}
	.source-map {
		border: 1px solid #cfdaef;
		border-radius: 28px;
		background: white;
		box-shadow: var(--shadow-soft);
		padding: 26px;
	}
	.source-row,
	.notificator-node {
		display: flex;
		align-items: center;
		gap: 14px;
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 14px;
	}
	.source-row + .source-row {
		margin-top: 10px;
	}
	.source-row > span,
	.notificator-node > span {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border-radius: 13px;
		background: var(--blue-pale);
		font-family: "JetBrains Mono", monospace;
		font-weight: 800;
		color: var(--blue);
	}
	.source-row small,
	.notificator-node small {
		display: block;
		color: var(--ink-soft);
	}
	.source-map > i {
		display: block;
		margin: 11px 0;
		text-align: center;
		color: #8293b5;
	}
	.notificator-node {
		border-color: #b9caff;
		background: #edf2ff;
	}
	.platform-section,
	.destination-section {
		background: #f5f7fb;
	}
	.platform-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: 44px;
	}
	.platform-grid > a {
		display: flex;
		min-height: 470px;
		flex-direction: column;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: white;
		padding: clamp(26px, 4vw, 40px);
		box-shadow: var(--shadow-soft);
	}
	.platform-grid > a.preview {
		background: linear-gradient(145deg, #fff, #f1eeff);
	}
	.platform-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.platform-top span {
		display: grid;
		width: 52px;
		height: 52px;
		place-items: center;
		border-radius: 15px;
		background: var(--blue-pale);
		font-weight: 800;
		color: var(--blue);
	}
	.platform-top small {
		border-radius: 999px;
		background: #e7edfb;
		padding: 7px 10px;
		font-weight: 750;
		color: #405170;
	}
	.platform-grid h3 {
		margin: 30px 0 0;
		font-size: clamp(1.7rem, 3vw, 2.35rem);
	}
	.platform-grid p,
	.platform-grid li,
	.shared-steps p,
	.destination-grid p,
	.future-card p {
		color: var(--ink-soft);
		line-height: 1.7;
	}
	.platform-grid ul {
		padding-left: 1.2rem;
		line-height: 1.8;
	}
	.platform-grid > a > strong {
		margin-top: auto;
		padding-top: 24px;
		color: var(--blue);
	}
	.shared-layout > div > a {
		display: inline-block;
		margin-top: 22px;
		font-weight: 750;
		color: var(--blue);
	}
	.shared-steps {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.shared-steps li {
		display: flex;
		gap: 16px;
		border: 1px solid var(--line);
		border-radius: 18px;
		padding: 20px;
	}
	.shared-steps span {
		font-family: "JetBrains Mono", monospace;
		color: var(--blue);
	}
	.shared-steps p {
		margin: 5px 0 0;
	}
	.destination-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		margin-top: 40px;
	}
	.destination-grid article {
		border: 1px solid var(--line);
		border-radius: 20px;
		background: white;
		padding: 22px;
	}
	.destination-grid article > span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.75rem;
		font-weight: 800;
		color: var(--blue);
	}
	.future-section {
		padding: 0 0 clamp(68px, 8vw, 100px);
	}
	.future-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
		border-radius: 28px;
		background: #0b1020;
		padding: clamp(30px, 5vw, 52px);
		color: white;
	}
	.future-card > div:first-child {
		max-width: 740px;
	}
	.future-card h2 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3.4rem);
	}
	.future-card p {
		color: #bfcbe7;
	}
	.future-card > div:last-child {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
	}
	.future-card > div:last-child > a:not(.button) {
		color: #a9c0ff;
		font-weight: 750;
	}
	@media (max-width: 900px) {
		.destination-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 760px) {
		.hero-grid,
		.shared-layout,
		.platform-grid {
			grid-template-columns: 1fr;
		}
		.destination-grid {
			grid-template-columns: 1fr;
		}
		.future-card {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>

---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { changelogEntries, changelogSystems } from "@/data/changelog";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "Notificator Changelog | Every part of the project",
	description:
		"Follow releases and improvements across the Notificator WordPress Plugin, Strapi Extension, mobile app, device firmware, API, website, and documentation.",
	canonical: "https://notificator-project.com/changelog/",
	openGraph: {
		url: "https://notificator-project.com/changelog/",
		title: "The Notificator Changelog",
		description: "One timeline for every moving part of the open-source Notificator project.",
	},
};

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
	timeZone: "UTC",
});

const systemLookup = Object.fromEntries(changelogSystems.map((system) => [system.id, system]));
const connectedSystemCount = changelogSystems.filter((system) => system.id !== "project").length;
const latestEntries = changelogEntries.slice(0, 3);
const latestDate = changelogEntries[0]?.date;
const latestDateLabel = latestDate ? dateFormatter.format(new Date(`${latestDate}T12:00:00Z`)) : "Recently";
---

<BaseLayout seo={seo}>
	<section class="changelog-hero section-space">
		<div class="site-shell hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">Project changelog</p>
				<h1 class="display-title">Every moving part, in one place.</h1>
				<p class="section-copy">
					Notificator is more than one app or extension. Follow meaningful releases across the WordPress Plugin, Strapi Extension, mobile,
					firmware, the API, this website, and the documentation, together with the milestones that shaped the project.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#release-timeline">Browse every update</a>
					<a class="button button-secondary" href="https://github.com/notificator-project">Follow development ↗</a>
				</div>
			</div>

			<aside class="release-radar" aria-labelledby="release-radar-title">
				<div class="radar-heading">
					<div>
						<span class="live-dot" aria-hidden="true"></span>
						<p>Latest wave</p>
					</div>
					<time datetime={latestDate}>{latestDateLabel}</time>
				</div>
				<h2 id="release-radar-title">A clearer app, and a new way to connect Strapi.</h2>
				<p>
					Mobile settings and controls are more consistent, while the first Strapi Extension preview brings rule-based content alerts to the
					project.
				</p>
				<div class="radar-systems" aria-label="Systems included in the latest release wave">
					{
						latestEntries.map((entry) => {
							const system = systemLookup[entry.system];
							return (
								<a href={`#${entry.id}`} data-system={entry.system}>
									<span aria-hidden="true">{system.marker}</span>
									<div>
										<small>{system.shortLabel}</small>
										<strong>
											{entry.version}
											{entry.build && <span> · build {entry.build}</span>}
										</strong>
									</div>
								</a>
							);
						})
					}
				</div>
			</aside>
		</div>
	</section>

	<section class="changelog-overview" aria-label="Changelog overview">
		<div class="site-shell overview-card">
			<div class="overview-stats">
				<div>
					<span>Systems</span>
					<strong>{connectedSystemCount}</strong>
					<p>Connected parts of one platform</p>
				</div>
				<div>
					<span>Milestones</span>
					<strong>{changelogEntries.length}</strong>
					<p>Curated project updates</p>
				</div>
				<div>
					<span>Development</span>
					<strong>Open</strong>
					<p>Source-first by default</p>
				</div>
			</div>
			<div class="overview-note">
				<span>Curated by design</span>
				<strong>Useful changes, without the commit noise.</strong>
				<p>Technical work is translated into the improvements people can see, use, and rely on across the project.</p>
				<a href="#release-timeline">Browse the timeline ↓</a>
			</div>
		</div>
	</section>

	<section id="release-timeline" class="timeline-section section-space" aria-labelledby="timeline-title">
		<div class="site-shell">
			<div class="timeline-heading">
				<div>
					<p class="eyebrow">Release timeline</p>
					<h2 id="timeline-title" class="section-title">Pick a system, or see the whole project evolve.</h2>
				</div>
				<p class="section-copy">
					Major improvements, public releases, and defining project moments appear here. This is a curated history, not an exhaustive commit
					log.
				</p>
			</div>

			<div class="system-filters" role="group" aria-label="Filter changelog by system">
				<button type="button" data-changelog-filter="all" data-filter-label="all systems" aria-pressed="true">
					<span aria-hidden="true">ALL</span>
					All systems
					<small>{changelogEntries.length}</small>
				</button>
				{
					changelogSystems.map((system) => {
						const count = changelogEntries.filter((entry) => entry.system === system.id).length;
						return (
							<button
								type="button"
								data-changelog-filter={system.id}
								data-filter-label={system.label}
								data-system={system.id}
								aria-pressed="false">
								<span aria-hidden="true">{system.marker}</span>
								{system.shortLabel}
								<small>{count}</small>
							</button>
						);
					})
				}
			</div>

			<p class="filter-status" aria-live="polite" data-filter-status>Showing all {changelogEntries.length} updates.</p>

			<div class="release-list">
				{
					changelogEntries.map((entry, index) => {
						const system = systemLookup[entry.system];
						const formattedDate = dateFormatter.format(new Date(`${entry.date}T12:00:00Z`));
						return (
							<article id={entry.id} class="release-entry" data-changelog-entry data-system={entry.system}>
								<div class="release-date">
									<time datetime={entry.date}>{formattedDate}</time>
									{index === 0 && <span>Latest</span>}
								</div>
								<div class="timeline-marker" aria-hidden="true">
									<span data-system={entry.system}>{system.marker}</span>
								</div>
								<div class="release-card">
									<div class="release-meta">
										<span class="system-badge" data-system={entry.system}>
											{system.label}
										</span>
										<span class="version-badge">{entry.version}</span>
										{entry.build && <span class="build-badge">Build {entry.build}</span>}
									</div>
									<h3>{entry.title}</h3>
									<p>{entry.summary}</p>
									<ul>
										{entry.changes.map((change) => (
											<li>{change}</li>
										))}
									</ul>
									{entry.link && (
										<a
											href={entry.link.href}
											target={entry.link.href.startsWith("http") ? "_blank" : undefined}
											rel={entry.link.href.startsWith("http") ? "noreferrer" : undefined}>
											{entry.link.label} <span aria-hidden="true">↗</span>
										</a>
									)}
								</div>
							</article>
						);
					})
				}
			</div>
		</div>
	</section>

	<section class="page-cta">
		<div class="site-shell page-cta-card">
			<div>
				<p class="eyebrow">Built in public</p>
				<h2>Want the unfiltered version?</h2>
				<p>Every repository is available on GitHub, including code, issues, release assets, and the decisions behind them.</p>
			</div>
			<div class="cta-actions">
				<a class="button button-primary" href="https://github.com/notificator-project">Explore the source ↗</a>
				<a href="/blog/">Read the project journal</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.changelog-hero {
		padding-top: clamp(68px, 8vw, 108px);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(350px, 0.85fr);
		gap: clamp(44px, 8vw, 100px);
		align-items: center;
	}

	.hero-copy .display-title {
		max-width: 820px;
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 32px;
	}

	.release-radar {
		position: relative;
		overflow: hidden;
		border-radius: 30px;
		background: radial-gradient(circle at 110% -10%, rgba(63, 124, 255, 0.55), transparent 44%), linear-gradient(145deg, #111a32, #080d1b 72%);
		box-shadow: 0 34px 90px rgba(13, 24, 52, 0.24);
		padding: clamp(26px, 4vw, 40px);
		color: white;
	}

	.release-radar::after {
		position: absolute;
		right: -80px;
		bottom: -130px;
		width: 260px;
		height: 260px;
		border: 1px solid rgba(106, 151, 255, 0.28);
		border-radius: 50%;
		box-shadow:
			0 0 0 34px rgba(84, 134, 255, 0.07),
			0 0 0 68px rgba(84, 134, 255, 0.04);
		content: "";
		pointer-events: none;
	}

	.radar-heading,
	.radar-heading > div {
		display: flex;
		align-items: center;
	}

	.radar-heading {
		justify-content: space-between;
		gap: 18px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #aebfe5;
	}

	.radar-heading > div {
		gap: 9px;
	}

	.radar-heading p {
		margin: 0;
	}

	.live-dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #35dda0;
		box-shadow: 0 0 0 5px rgba(53, 221, 160, 0.13);
	}

	.release-radar h2 {
		max-width: 470px;
		margin: 38px 0 14px;
		font-size: clamp(1.8rem, 3.4vw, 2.75rem);
		letter-spacing: -0.045em;
		line-height: 1.04;
	}

	.release-radar > p {
		max-width: 470px;
		margin: 0;
		line-height: 1.65;
		color: #bfcae1;
	}

	.radar-systems {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 9px;
		margin-top: 34px;
	}

	.radar-systems a {
		display: flex;
		align-items: center;
		gap: 13px;
		border: 1px solid rgba(255, 255, 255, 0.11);
		border-radius: 15px;
		background: rgba(255, 255, 255, 0.06);
		padding: 11px 13px;
		transition: 160ms ease;
	}

	.radar-systems a:hover {
		transform: translateX(4px);
		border-color: rgba(255, 255, 255, 0.22);
		background: rgba(255, 255, 255, 0.1);
	}

	.radar-systems a > span,
	.timeline-marker span {
		display: grid;
		width: 42px;
		height: 42px;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 12px;
		background: var(--system-bg, #eaf0ff);
		font-family: "JetBrains Mono", monospace;
		font-size: 0.68rem;
		font-weight: 800;
		color: var(--system-color, var(--blue));
	}

	.radar-systems a div {
		display: grid;
		gap: 2px;
	}

	.radar-systems small {
		color: #aebfe5;
	}

	.radar-systems strong {
		font-size: 0.95rem;
	}

	.radar-systems strong span {
		font-size: 0.78rem;
		font-weight: 600;
		color: #aebfe5;
	}

	.changelog-overview {
		padding-bottom: clamp(22px, 4vw, 50px);
	}

	.overview-card {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(320px, 0.85fr);
		gap: 16px;
		border: 1px solid var(--line);
		border-radius: 28px;
		background: #edf3ff;
		padding: 16px;
		box-shadow: 0 18px 50px rgba(24, 39, 75, 0.07);
	}

	.overview-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
	}

	.overview-stats > div {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		min-height: 158px;
		border: 1px solid rgba(112, 142, 210, 0.2);
		border-radius: 19px;
		background: rgba(255, 255, 255, 0.88);
		padding: 22px;
	}

	.overview-stats span,
	.overview-note > span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.overview-stats span {
		color: var(--blue);
	}

	.overview-stats strong {
		margin-top: 25px;
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.overview-stats p {
		margin: auto 0 0;
		font-size: 0.84rem;
		line-height: 1.45;
		color: var(--ink-soft);
	}

	.overview-note {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		border-radius: 20px;
		background: linear-gradient(145deg, #14234b, #0b1020);
		padding: 26px;
		color: white;
	}

	.overview-note > span {
		color: #7fa7ff;
	}

	.overview-note strong {
		max-width: 360px;
		margin-top: 20px;
		font-size: clamp(1.25rem, 2.3vw, 1.75rem);
		letter-spacing: -0.04em;
		line-height: 1.14;
	}

	.overview-note p {
		margin: 12px 0 0;
		font-size: 0.88rem;
		line-height: 1.65;
		color: #bfcbe7;
	}

	.overview-note a {
		margin-top: auto;
		padding-top: 22px;
		font-size: 0.85rem;
		font-weight: 750;
		color: white;
	}

	.timeline-section {
		padding-top: clamp(70px, 8vw, 105px);
	}

	.timeline-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
		gap: 40px;
		align-items: end;
	}

	.timeline-heading .section-copy {
		margin: 0;
	}

	.system-filters {
		display: flex;
		overflow-x: auto;
		gap: 9px;
		margin: 44px 0 0;
		padding: 4px 4px 12px;
		scrollbar-width: thin;
	}

	.system-filters button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		gap: 9px;
		flex: 0 0 auto;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.72);
		padding: 7px 10px 7px 8px;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--ink-soft);
		cursor: pointer;
		transition: 150ms ease;
	}

	.system-filters button:hover,
	.system-filters button[aria-pressed="true"] {
		transform: translateY(-1px);
		border-color: #b8c8ee;
		background: white;
		box-shadow: 0 10px 25px rgba(24, 39, 75, 0.09);
		color: var(--ink);
	}

	.system-filters button > span {
		display: grid;
		min-width: 34px;
		height: 34px;
		place-items: center;
		border-radius: 9px;
		background: var(--system-bg, var(--blue-pale));
		font-family: "JetBrains Mono", monospace;
		font-size: 0.61rem;
		font-weight: 800;
		color: var(--system-color, var(--blue));
	}

	.system-filters small {
		display: grid;
		min-width: 23px;
		height: 23px;
		place-items: center;
		border-radius: 20px;
		background: #edf0f6;
		font-size: 0.7rem;
		color: #667087;
	}

	.filter-status {
		margin: 4px 0 28px;
		font-size: 0.88rem;
		color: var(--ink-soft);
	}

	.release-list {
		position: relative;
	}

	.release-list::before {
		position: absolute;
		top: 24px;
		bottom: 24px;
		left: 188px;
		width: 1px;
		background: linear-gradient(var(--blue), var(--line) 12%, var(--line) 88%, transparent);
		content: "";
	}

	.release-entry {
		display: grid;
		grid-template-columns: 160px 56px minmax(0, 1fr);
		gap: 0 0;
		align-items: start;
		padding: 0 0 26px;
		scroll-margin-top: 130px;
	}

	.release-entry[hidden] {
		display: none;
	}

	.release-date {
		display: grid;
		justify-items: end;
		gap: 7px;
		padding: 18px 18px 0 0;
	}

	.release-date time {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.76rem;
		font-weight: 700;
		color: #5f6980;
	}

	.release-date span {
		border-radius: 20px;
		background: #dcf8eb;
		padding: 4px 8px;
		font-size: 0.68rem;
		font-weight: 750;
		text-transform: uppercase;
		color: #087c4c;
	}

	.timeline-marker {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: start center;
		padding-top: 8px;
	}

	.timeline-marker span {
		border: 6px solid var(--canvas);
		box-sizing: content-box;
	}

	.release-card {
		border: 1px solid var(--line);
		border-radius: 22px;
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 18px 55px rgba(24, 39, 75, 0.07);
		padding: clamp(22px, 4vw, 34px);
		transition:
			transform 170ms ease,
			box-shadow 170ms ease,
			border-color 170ms ease;
	}

	.release-card:hover {
		transform: translateY(-2px);
		border-color: #c9d5ef;
		box-shadow: 0 24px 65px rgba(24, 39, 75, 0.11);
	}

	.release-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.system-badge,
	.version-badge,
	.build-badge {
		border-radius: 30px;
		padding: 6px 10px;
		font-size: 0.72rem;
		font-weight: 750;
	}

	.system-badge {
		background: var(--system-bg, var(--blue-pale));
		color: var(--system-color, var(--blue));
	}

	.version-badge {
		background: #eef1f6;
		color: #4f5970;
	}

	.build-badge {
		border: 1px solid #dfe5ef;
		background: transparent;
		color: #69748c;
	}

	.release-card h3 {
		margin: 18px 0 10px;
		font-size: clamp(1.45rem, 2.6vw, 2.05rem);
		letter-spacing: -0.035em;
		line-height: 1.12;
	}

	.release-card > p {
		max-width: 760px;
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.release-card ul {
		display: grid;
		gap: 9px;
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
	}

	.release-card li {
		position: relative;
		padding-left: 23px;
		line-height: 1.55;
		color: #34405a;
	}

	.release-card li::before {
		position: absolute;
		top: 0.68em;
		left: 3px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--blue-bright);
		content: "";
	}

	.release-card > a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 24px;
		font-size: 0.92rem;
		font-weight: 750;
		color: var(--blue);
	}

	.release-card > a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.page-cta {
		padding: 12px 0 clamp(80px, 10vw, 130px);
	}

	.page-cta-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 38px;
		border-radius: 28px;
		background: #e9effd;
		padding: clamp(28px, 5vw, 50px);
	}

	.page-cta h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3vw, 2.8rem);
		letter-spacing: -0.045em;
	}

	.page-cta p:not(.eyebrow) {
		max-width: 650px;
		margin: 12px 0 0;
		color: var(--ink-soft);
	}

	.cta-actions {
		align-items: center;
		justify-content: flex-end;
		margin: 0;
	}

	.cta-actions > a:not(.button) {
		font-weight: 700;
		color: var(--blue);
	}

	[data-system="project"] {
		--system-bg: #e4edff;
		--system-color: #245be0;
	}
	[data-system="wordpress"] {
		--system-bg: #e8f2ff;
		--system-color: #1769a8;
	}
	[data-system="strapi"] {
		--system-bg: #eeeaff;
		--system-color: #5b3fc4;
	}
	[data-system="mobile"] {
		--system-bg: #ece8ff;
		--system-color: #6246c7;
	}
	[data-system="firmware"] {
		--system-bg: #ddf8ed;
		--system-color: #087c58;
	}
	[data-system="api"] {
		--system-bg: #fff0d8;
		--system-color: #9a5b00;
	}
	[data-system="website"] {
		--system-bg: #ffe8f1;
		--system-color: #a73363;
	}
	[data-system="docs"] {
		--system-bg: #e7efff;
		--system-color: #315db8;
	}

	@media (max-width: 900px) {
		.hero-grid,
		.timeline-heading {
			grid-template-columns: 1fr;
		}

		.release-radar {
			max-width: 680px;
		}

		.overview-card {
			grid-template-columns: 1fr;
		}

		.timeline-heading .section-copy {
			margin-top: 0;

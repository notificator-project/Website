<script>
	const initialiseChangelog = () => {
		const filterGroup = document.querySelector<HTMLElement>(".system-filters");
		const entries = Array.from(document.querySelectorAll<HTMLElement>("[data-changelog-entry]"));
		const status = document.querySelector<HTMLElement>("[data-filter-status]");
		if (!filterGroup || filterGroup.dataset.ready === "true") return;

		filterGroup.dataset.ready = "true";
		const buttons = Array.from(filterGroup.querySelectorAll<HTMLButtonElement>("[data-changelog-filter]"));

		const applyFilter = (requestedFilter: string, updateUrl = true) => {
			const validFilters = new Set(["all", ...buttons.map((button) => button.dataset.changelogFilter || "")]);
			const filter = validFilters.has(requestedFilter) ? requestedFilter : "all";
			let visibleCount = 0;

			buttons.forEach((button) => {
				button.setAttribute("aria-pressed", String(button.dataset.changelogFilter === filter));
			});
			entries.forEach((entry) => {
				const visible = filter === "all" || entry.dataset.system === filter;
				entry.hidden = !visible;
				if (visible) visibleCount += 1;
			});

			if (status) {
				const label = buttons.find((button) => button.dataset.changelogFilter === filter)?.dataset.filterLabel;
				status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "update" : "updates"} for ${label || filter}.`;
			}

			if (updateUrl) {
				const url = new URL(window.location.href);
				if (filter === "all") url.searchParams.delete("system");
				else url.searchParams.set("system", filter);
				history.replaceState({}, "", url);
			}
		};

		buttons.forEach((button) => {
			button.addEventListener("click", () => applyFilter(button.dataset.changelogFilter || "all"));
		});

		applyFilter(new URL(window.location.href).searchParams.get("system") || "all", false);
	};

	document.addEventListener("astro:page-load", initialiseChangelog);
	initialiseChangelog();
</script>

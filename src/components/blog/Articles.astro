---
import { getCollection } from "astro:content";
import Entry from "@/components/blog/Entry.astro";

const allPosts = (await getCollection("posts"))
	.filter((post) => post.slug.startsWith("en/"))
	.map((post) => ({ ...post, slug: post.slug.split("/").slice(1).join("/") }))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const [featured, ...articles] = allPosts;
---

<section class="blog-index section-space">
	<div class="site-shell">
		<header class="blog-hero">
			<div>
				<div class="journal-kicker">
					<p class="eyebrow">Project journal</p>
					<a class="rss-link" href="/rss.xml" aria-label="Subscribe to the Notificator Journal RSS feed">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="5" cy="19" r="2"></circle>
							<path d="M4 11a9 9 0 0 1 9 9"></path>
							<path d="M4 4a16 16 0 0 1 16 16"></path>
						</svg>
						<span>RSS</span>
					</a>
				</div>
				<h1 class="display-title">Ideas, releases, and the work behind Notificator.</h1>
			</div>
			<p>
				Release notes, practical notification patterns, integration updates, and occasional dispatches from building an open-source platform.
			</p>
		</header>

		{
			featured && (
				<div class="featured-post">
					<Entry
						url={`/blog/${featured.slug}/`}
						title={featured.data.title}
						description={featured.data.description}
						pubDate={featured.data.pubDate.toISOString()}
						author={featured.data.author}
						image={featured.data.image.source}
						featured={true}
					/>
				</div>
			)
		}

		<div class="articles-heading"><h2>All stories</h2><span>{allPosts.length} articles</span></div>
		<div class="article-grid">
			{
				articles.map((post) => (
					<Entry
						url={`/blog/${post.slug}/`}
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate.toISOString()}
						author={post.data.author}
						image={post.data.image.source}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.blog-index {
		padding-top: clamp(70px, 8vw, 110px);
	}

	.blog-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(300px, 0.45fr);
		gap: 60px;
		align-items: end;
	}

	.journal-kicker {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.journal-kicker .eyebrow {
		margin: 0;
	}

	.rss-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 6px 10px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--brand);
		transition:
			border-color 150ms ease,
			background 150ms ease;
	}

	.rss-link:hover {
		border-color: var(--brand);
		background: var(--brand-soft);
	}

	.rss-link svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 2;
	}

	.blog-hero .display-title {
		max-width: 800px;
		font-size: clamp(2.8rem, 5.5vw, 5.3rem);
	}

	.blog-hero > p {
		margin: 0 0 8px;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.featured-post {
		margin-top: 64px;
	}

	.articles-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		margin-top: 78px;
		border-bottom: 1px solid var(--line);
		padding-bottom: 16px;
	}

	.articles-heading h2 {
		margin: 0;
		font-size: 1.45rem;
		letter-spacing: -0.03em;
	}

	.articles-heading span {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
		color: #536078;
	}

	.article-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin-top: 24px;
	}

	@media (max-width: 880px) {
		.blog-hero {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.article-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 580px) {
		.article-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

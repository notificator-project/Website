---
import Newsletter from "@components/blog/Newsletter.astro";

const buildDate = new Date();
const projectTimeZone = "Europe/Athens";
const dateParts = Object.fromEntries(
	new Intl.DateTimeFormat("en-GB", {
		day: "2-digit",
		month: "2-digit",
		year: "numeric",
		timeZone: projectTimeZone,
	})
		.formatToParts(buildDate)
		.filter(({ type }) => type !== "literal")
		.map(({ type, value }) => [type, value]),
);
const year = dateParts.year;
const lastUpdatedIso = `${dateParts.year}-${dateParts.month}-${dateParts.day}`;
const lastUpdated = new Intl.DateTimeFormat("en-GB", {
	day: "numeric",
	month: "long",
	year: "numeric",
	timeZone: projectTimeZone,
}).format(buildDate);
---

<footer class="site-footer">
	<div class="site-shell footer-card">
		<div class="footer-lead">
			<a class="footer-brand" href="/" aria-label="Notificator home">
				<img src="/notificator-icon-on-dark.png" alt="" aria-hidden="true" />
				<span>Notificator</span>
			</a>
			<p>Turn meaningful WordPress events into alerts you can act on.</p>
			<Newsletter />
			<nav class="footer-social" aria-label="Social media">
				<span>Follow the project</span>
				<a href="https://github.com/notificator-project" target="_blank" rel="noreferrer" aria-label="Notificator on GitHub">
					<img src="/social-icons/github.svg" alt="" aria-hidden="true" />
				</a>
				<a href="https://x.com/WP_Notificator" target="_blank" rel="noreferrer" aria-label="Notificator on X">
					<img src="/social-icons/x.svg" alt="" aria-hidden="true" />
				</a>
				<a href="https://www.youtube.com/@NotificatorProject" target="_blank" rel="noreferrer" aria-label="Notificator on YouTube">
					<img src="/social-icons/youtube.svg" alt="" aria-hidden="true" />
				</a>
			</nav>
		</div>

		<div class="footer-right">
			<nav class="footer-links" aria-label="Footer navigation">
				<div>
					<h2>Explore</h2>
					<a href="/wordpress/">WordPress Plugin</a>
					<a href="/strapi/">Strapi Extension</a>
					<a href="/mobile-app/">Mobile app</a>
					<a href="/devices/">Devices</a>
					<a href="/get-a-device/">Get a device</a>
					<a href="/build-a-device/">Build a device</a>
					<a href="/firmware-installer/">Firmware installer</a>
					<a href="/how-it-works/">How it works</a>
					<a href="/integrations/">Integrations</a>
				</div>
				<div>
					<h2>Resources</h2>
					<a href="https://docs.notificator-project.com/">Documentation</a>
					<a href="/changelog/">Changelog</a>
					<a href="/support/">Support</a>
					<a href="/blog/">Blog</a>
				</div>
				<div>
					<h2>Project</h2>
					<a href="/contact/">Contact</a>
					<a href="/privacy/">Privacy</a>
					<a href="/credits/">Credits</a>
					<a href="https://buymeacoffee.com/vagelis">Donate</a>
					<a href="https://github.com/sponsors/vagelisp">Sponsor</a>
				</div>
			</nav>

			<aside class="footer-apps" aria-labelledby="footer-apps-title">
				<h2 id="footer-apps-title">Get the mobile app</h2>
				<div class="store-badges">
					<span class="store-badge" aria-label="Notificator for iOS has been approved and is coming soon to the App Store">
						<span class="store-icon store-icon--ios" aria-hidden="true">iOS</span>
						<span><small>Approved · coming soon</small><strong>App Store</strong></span>
					</span>
					<span class="store-badge" aria-label="Notificator for Android is coming soon to Google Play">
						<span class="store-icon store-icon--play" aria-hidden="true"></span>
						<span><small>Coming soon on</small><strong>Google Play</strong></span>
					</span>
				</div>
			</aside>
		</div>

		<aside class="independence-notice" aria-labelledby="independence-notice-title">
			<strong id="independence-notice-title">Independent project</strong>
			<p>
				Notificator is not affiliated with, endorsed by, or sponsored by WordPress.org, the WordPress Foundation, Automattic, Strapi Solutions
				SAS, Waveshare, or HiveMQ. References to WordPress and Strapi describe compatibility and open-source community participation.
				References to Waveshare identify compatible hardware, while references to HiveMQ identify the currently supported user-owned MQTT
				service. Their product names, trademarks, services, and terms remain their own.
			</p>
		</aside>

		<div class="footer-bottom">
			<div class="footer-meta">
				<span>© {year} Notificator Project</span>
				<span aria-hidden="true">·</span>
				<span>Last updated <time datetime={lastUpdatedIso}>{lastUpdated}</time></span>
			</div>
			<span class="open-source-note">Free and open source</span>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 30px 0 36px;
	}

	.footer-card {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: 40px;
		border-radius: 30px;
		background: #0b1020;
		padding: clamp(34px, 6vw, 58px);
		color: white;
	}

	.footer-lead p {
		max-width: 440px;
		margin: 28px 0 0;
		font-size: clamp(1.35rem, 2.5vw, 2.15rem);
		font-weight: 650;
		letter-spacing: -0.035em;
		line-height: 1.18;
		color: #dce4fa;
	}

	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		font-size: 1rem;
		font-weight: 750;
		color: white;
	}

	.footer-brand img {
		display: block;
		width: 42px;
		height: 42px;
		object-fit: contain;
	}

	.footer-lead :global(.newsletter-form) {
		margin-top: 34px;
	}

	.footer-social {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 24px;
	}

	.footer-social > span {
		margin-right: 8px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #aeb9d2;
	}

	.footer-social a {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		transition:
			transform 150ms ease,
			border-color 150ms ease,
			background 150ms ease;
	}

	.footer-social a:hover {
		transform: translateY(-2px);
		border-color: rgba(255, 255, 255, 0.28);
		background: rgba(255, 255, 255, 0.12);
	}

	.footer-social img {
		width: 20px;
		height: 20px;
		filter: brightness(0) invert(1);
		opacity: 1;
	}

	.footer-social a:nth-child(2) img {
		width: 17px;
		height: 17px;
	}

	.footer-social a:nth-child(3) img {
		width: 22px;
		height: 22px;
	}

	.footer-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.footer-right {
		display: flex;
		min-width: 0;
		flex-direction: column;
	}

	.footer-links div {
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: 11px;
	}

	.footer-links h2 {
		margin: 0 0 6px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #aeb9d2;
	}

	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 5px 9px;
	}

	.open-source-note {
		margin-left: auto;
		white-space: nowrap;
	}

	.footer-links a {
		font-size: 0.95rem;
		color: #dce4fa;
	}

	.footer-links a:hover {
		color: white;
	}

	.footer-apps {
		margin-top: auto;
		padding-top: 34px;
	}

	.footer-apps h2 {
		margin: 0 0 12px;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #aeb9d2;
	}

	.store-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.store-badge {
		display: inline-flex;
		min-width: 184px;
		align-items: center;
		gap: 11px;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 13px;
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.18);
		padding: 10px 14px;
		color: white;
	}

	.store-badge:first-child {
		background: linear-gradient(135deg, #1687f8 0%, #0865d8 100%);
	}

	.store-badge:last-child {
		background: linear-gradient(135deg, #158b69 0%, #08745f 100%);
	}

	.store-badge > span:last-child {
		display: flex;
		flex-direction: column;
		line-height: 1.05;
	}

	.store-badge small {
		font-size: 0.64rem;
		letter-spacing: 0.01em;
		color: rgba(255, 255, 255, 0.82);
	}

	.store-badge strong {
		margin-top: 4px;
		font-size: 1rem;
		letter-spacing: -0.015em;
	}

	.store-icon {
		display: grid;
		width: 29px;
		height: 29px;
		flex: 0 0 29px;
		place-items: center;
		font-size: 0.65rem;
		font-weight: 800;
	}

	.store-icon--ios {
		border: 1px solid rgba(255, 255, 255, 0.65);
		border-radius: 9px;
		background: rgba(255, 255, 255, 0.12);
	}

	.store-icon--play {
		position: relative;
	}

	.store-icon--play::before {
		width: 24px;
		height: 26px;
		background: conic-gradient(from -42deg at 45% 50%, #30d5f3 0deg 88deg, #35e38b 88deg 180deg, #ffd84a 180deg 270deg, #ff5c6b 270deg);
		clip-path: polygon(0 0, 100% 50%, 0 100%);
		content: "";
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
	}

	.independence-notice {
		grid-column: 1 / -1;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 24px;
	}

	.independence-notice strong {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #dce4fa;
	}

	.independence-notice p {
		max-width: 900px;
		margin: 8px 0 0;
		font-size: 0.8rem;
		line-height: 1.65;
		color: #aeb9d2;
	}

	.footer-bottom {
		display: flex;
		grid-column: 1 / -1;
		flex-wrap: wrap;
		gap: 10px 24px;
		justify-content: space-between;
		font-size: 0.85rem;
		color: #aeb9d2;
	}

	@media (max-width: 820px) {
		.footer-card {
			grid-template-columns: 1fr;
			gap: 52px;
		}

		.footer-apps {
			margin-top: 0;
		}
	}

	@media (max-width: 560px) {
		.footer-links {
			grid-template-columns: 1fr 1fr;
		}

		.footer-bottom {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}

		.open-source-note {
			align-self: flex-end;
		}

		.store-badges {
			flex-direction: column;
		}

		.store-badge {
			box-sizing: border-box;
			width: 100%;
		}
	}
</style>
